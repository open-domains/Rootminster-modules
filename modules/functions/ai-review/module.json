{
  "schemaVersion": 1,
  "version": "1.0.0",
  "engines": {
    "rootminster": ">=1.0.0",
    "node": ">=20"
  },
  "publisher": {
    "name": "Open Domains",
    "url": "https://github.com/open-domains"
  },
  "license": "MIT",
  "id": "rootminster-ai-review",
  "name": "AI Review",
  "category": "function",
  "description": "Review domain applications using an OpenAI-compatible API.",
  "main": "index.js",
  "permissions": [
    "network:configured",
    "secrets:read",
    "domains:read"
  ],
  "capabilities": [
    "domain:review"
  ],
  "dependencies": {},
  "secrets": [
    "apiKey"
  ],
  "configSchema": {
    "type": "object",
    "required": [
      "endpoint",
      "apiKey",
      "model"
    ],
    "properties": {
      "endpoint": {
        "type": "string",
        "format": "uri",
        "default": "https://api.openai.com/v1"
      },
      "apiKey": {
        "type": "string",
        "format": "password"
      },
      "model": {
        "type": "string"
      },
      "systemPrompt": {
        "type": "string"
      }
    },
    "additionalProperties": false
  }
}
