{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rootminster.com/schemas/registry-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "publisher", "modules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string" },
    "publisher": { "const": "open-domains" },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "version", "description", "manifestUrl", "manifestSha256"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "version": { "type": "string" },
          "description": { "type": "string" },
          "manifestUrl": { "type": "string", "format": "uri" },
          "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
